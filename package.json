{
  "name": "lith-photo-studio",
  "version": "0.13.0",
  "description": "An offline desktop photo studio",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node tests.cjs && node storage-tests.cjs && node release-tests.cjs && node raw-tests.cjs && node engine-tests.cjs && node float-tests.cjs && node second-display-tests.cjs && node batch-tests.cjs && node look-sharing-tests.cjs && node creative-tests.cjs && node update-prompt-tests.cjs",
    "pack": "electron-builder --config electron-builder.config.cjs --dir",
    "dist:win": "electron-builder --config electron-builder.config.cjs --win --publish never",
    "dist:mac": "electron-builder --config electron-builder.config.cjs --mac --publish never",
    "benchmark:engine": "node engine-benchmark.cjs",
    "test:creative": "node creative-ui-tests.cjs",
    "benchmark:float": "node float-benchmark.cjs",
    "test:workspace": "node workspace-ui-tests.cjs && node workspace-tabs-tests.cjs"
  },
  "private": true,
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "electron": "44.4.5",
    "electron-builder": "26.15.3"
  },
  "overrides": {
    "@electron-internal/extract-zip": "1.0.5"
  },
  "dependencies": {
    "electron-updater": "6.8.9",
    "libraw-wasm": "1.6.0",
    "pngjs": "7.0.0"
  },
  "author": "skarn03",
  "repository": {
    "type": "git",
    "url": "https://github.com/skarn03/lith.git"
  }
}
